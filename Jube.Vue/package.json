{
  "name": "jube-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/ e2e/ *.ts",
    "test:watch": "vitest",
    "format:check": "prettier --check src/ e2e/ *.ts",
    "api:types": "openapi-typescript ${JUBE_OPENAPI:-http://127.0.0.1:5001/swagger/v1/swagger.json} -o src/api/schema.d.ts",
    "ci": "run-s format:check lint:eslint type-check test:unit build-only"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/vue-query": "^5.104.5",
    "codemirror": "^6.0.2",
    "deep-chat": "^2.5.1",
    "exceljs": "4.4.0",
    "jquery": "^3.7.1",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^6.15.0",
    "pinia": "^4.0.3",
    "tabulator-tables": "^6.6.1",
    "vue": "3.6.0-rc.12",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jquery": "^3.5.34",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/tabulator-tables": "^6.3.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "3.6.0-rc.12",
    "@vue/compiler-core": "3.6.0-rc.12",
    "@vue/compiler-dom": "3.6.0-rc.12",
    "@vue/compiler-sfc": "3.6.0-rc.12",
    "@vue/compiler-ssr": "3.6.0-rc.12",
    "@vue/compiler-vapor": "3.6.0-rc.12",
    "@vue/reactivity": "3.6.0-rc.12",
    "@vue/runtime-core": "3.6.0-rc.12",
    "@vue/runtime-dom": "3.6.0-rc.12",
    "@vue/runtime-vapor": "3.6.0-rc.12",
    "@vue/server-renderer": "3.6.0-rc.12",
    "@vue/shared": "3.6.0-rc.12",
    "@vue/compat": "3.6.0-rc.12"
  }
}
