<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Jube.RegulatoryReport</PackageId>
        <Description>Builds and validates regulatory report XML (goAML and other FIU formats) from a profile: a template, code lists and the FIU's own XSD. No database, web or Jube references.</Description>
        <PackageTags>aml;goaml;fiu;sar;str;regulatory-reporting;xml</PackageTags>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <Authors>Jube Holdings Limited</Authors>
    </PropertyGroup>

</Project>
