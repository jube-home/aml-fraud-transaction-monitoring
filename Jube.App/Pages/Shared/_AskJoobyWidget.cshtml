@{
    string askJoobyPageContextJson;
    try
    {
        var entries = new Dictionary<string, object>();
        foreach (var pair in ViewData)
        {
            if (pair.Value is not null)
            {
                entries[pair.Key] = pair.Value;
            }
        }

        askJoobyPageContextJson = System.Text.Json.JsonSerializer.Serialize(entries);
    }
    catch
    {
        askJoobyPageContextJson = "{}";
    }
}
<script>
    const AskJoobyPageContext = @Html.Raw(askJoobyPageContextJson);

    window.AskJoobySetPageContext = function (pageName, state, record) {
        AskJoobyPageContext.pageName = pageName;
        AskJoobyPageContext.state = state;
        AskJoobyPageContext.record = record === undefined ? null : record;
    };
</script>
<button type="button" id="askJoobyWidgetLauncher" aria-label="Open chat" aria-expanded="false">
    <img src="/images/askjooby-launcher-closed.png" alt="" class="askJoobyLauncherIcon askJoobyLauncherIconClosed">
    <img src="/images/askjooby-launcher-open.png" alt="" class="askJoobyLauncherIcon askJoobyLauncherIconOpen">
</button>
<div id="askJoobyWidgetPanel" style="display: none;">
    <div id="askJoobyWidgetHeader">
        <span>Jooby</span>
        <button type="button" id="askJoobyWidgetNew" title="New conversation">+</button>
    </div>
    <div id="askJoobyWidgetTranscript"></div>
    <div id="askJoobyWidgetComposer">
        <textarea id="askJoobyWidgetInput" placeholder="Ask Jooby..." rows="1"></textarea>
        <button type="button" id="askJoobyWidgetSend">Send</button>
    </div>
</div>
<script src="/js/AskJooby/AskJoobyStreamClient.js"></script>
<script src="/js/AskJooby/AskJoobyMarkdown.js" asp-append-version="true"></script>
<script src="/js/AskJooby/AskJoobyToolIcons.js" asp-append-version="true"></script>
<script src="/js/AskJooby/AskJoobyWidget.js" asp-append-version="true"></script>
