@inject DynamicEnvironment DynamicEnvironment
@inject ILog Log
@{
    var landlord = DynamicEnvironment.AppSettings("Landlord").Equals("True", StringComparison.OrdinalIgnoreCase);
    var showAskJoobyWidget = false;
    var askJoobyHasInferenceBackend = DynamicEnvironment.AppSettings("EnableAskJooby")
        .Equals("True", StringComparison.OrdinalIgnoreCase);
    Debug.Assert(User.Identity != null);
    var isAuthenticated = User.Identity.IsAuthenticated;
    PermissionValidation permissionValidation = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Jube.App</title>
    <link rel="stylesheet" href="/styles/bootstrap.min.css"/>
    <link rel="stylesheet" href="/styles/site.css"/>
    <link rel="stylesheet" href="/styles/jube.css"/>
    <link rel="stylesheet" href="/styles/askjooby.css" asp-append-version="true"/>
    <link rel="stylesheet" href="/styles/sessionWarning.css" asp-append-version="true"/>
    <link rel="stylesheet" href="/css/jube-charting.css?v=@Charting.ChartStylesheet.Version"/>
    <link rel="stylesheet" href="/kendo/styles/kendo.common.min.css"/>
    <link rel="stylesheet" href="/kendo/styles/kendo.silver.min.css"/>
    <script>window.AskJoobyHasInferenceBackend = @(askJoobyHasInferenceBackend ? "true" : "false");</script>
    <script src="/kendo/js/jquery.min.js"></script>
    <script src="/js/SessionWarning.js" asp-append-version="true"></script>
    <script src="/kendo/js/kendo.all.min.js"></script>
    <script src="/js/Approval/ApprovalManager.js"></script>
    @await RenderSectionAsync("Scripts", false).ConfigureAwait(false)
</head>
<body class="@(isAuthenticated ? "jube-authenticated" : "")">
<script>
    try {
        if (localStorage.getItem('jubeSidebarCollapsed') === '1') {
            document.body.classList.add('sidebarCollapsed');
        }
    } catch (e) {
        // Private browsing or blocked storage: the sidebar simply starts expanded.
    }
</script>
<header>
    @if (!isAuthenticated)
    {
        <a href="https://www.jube.io">
            <img class="loginHeaderLogo" alt="Jube" src="/images/logo.png"/>
        </a>
    }
    else
    {
        permissionValidation = new PermissionValidation(DynamicEnvironment.AppSettings("ConnectionString"), User.Identity?.Name, Log);
        landlord = permissionValidation.Landlord;
        showAskJoobyWidget = permissionValidation.ActiveUser &&
                             ViewData["HideAskJoobyWidget"] is not true;

        <button type="button" id="sidebarToggle" aria-label="Collapse navigation" aria-expanded="true">
            <span class="sidebarToggleIcon" aria-hidden="true"></span>
        </button>
        <a href="/" id="topbarBrandLink">
            <img alt="Jube" src="/images/logo.png" id="topbarBrandLogo"/>
        </a>
        <span id="currentPageLabel" aria-live="polite"></span>
        <span id="topbarSpacer"></span>

        @if (landlord)
        {
            <div id="tenantSwitcherMenuItem">
                <input id="Tenant"/>
            </div>
        }

        <div id="resourcesMenu" class="topbarMenu">
            <button type="button" id="resourcesMenuToggle" class="topbarMenuToggle topbarMenuToggle-resources"
                    aria-haspopup="true" aria-expanded="false" aria-label="Resources">
                <svg class="topbarMenuIcon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 5a2 2 0 0 1 2-2h5v18H6a2 2 0 0 1-2-2V5zM20 5a2 2 0 0 0-2-2h-5v18h5a2 2 0 0 0 2-2V5z"
                          fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
            </button>
            <ul id="resourcesMenuPanel" class="topbarMenuPanel" hidden>
                <li>
                    <a href="https://www.jube.io" target="_blank" rel="noopener">Documentation</a>
                </li>
                <li>
                    <a href="/Copyright">Copyright</a>
                </li>
            </ul>
        </div>

        <div id="accountMenu" class="topbarMenu">
            <button type="button" id="accountMenuToggle" class="topbarMenuToggle topbarMenuToggle-account"
                    aria-haspopup="true" aria-expanded="false" aria-label="Account">
                <svg class="topbarMenuIcon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.6" fill="currentColor"/>
                    <path d="M4.5 20c0-4.142 3.358-7.5 7.5-7.5s7.5 3.358 7.5 7.5"
                          fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </button>
            <ul id="accountMenuPanel" class="topbarMenuPanel" hidden>
                @if (!DynamicEnvironment.AppSettings("OAuthAuthentication").Equals("True", StringComparison.CurrentCultureIgnoreCase)
                     && !DynamicEnvironment.AppSettings("NegotiateAuthentication").Equals("True", StringComparison.CurrentCultureIgnoreCase))
                {
                    <li>
                        <a href="/Account/ChangePassword">Change Password</a>
                    </li>
                }

                <li>
                    <a href="#" onclick="jubeLogout(); return false;">Logout</a>
                </li>
            </ul>
        </div>
    }
</header>

