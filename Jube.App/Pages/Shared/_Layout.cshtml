@if (User.Identity is { IsAuthenticated: true })
{
    <script>
        @if (landlord)
        {
            <text>
                function onDataBound() {
                    $.get("/api/UserInTenant/GetCurrentTenantRegistry", function (data) {
                        $("#Tenant").data("kendoDropDownList").value(data.tenantRegistryId);
                    });
                }

                function onSelect(e) {
                    const dataItem = this.dataItem(e.item.index());
                    $.ajax({
                        url: '/api/UserInTenant',
                        type: 'PUT',
                        contentType: "application/json; charset=utf-8",
                        data: JSON.stringify({
                            tenantRegistryId: dataItem.id
                        }),
                        success: function () {
                            window.location.reload();
                        }
                    });
                }

                $(document).ready(function () {
                    $("#Tenant").kendoDropDownList({
                        dataTextField: 'name',
                        dataValueField: 'id',
                        filter: 'contains',
                        select: onSelect,
                        dataBound: onDataBound,
                        dataSource: {
                            serverFiltering: true,
                            transport: {
                                read: '/api/TenantRegistry/ByFilter'
                            }
                        }
                    });
                });
            </text>
        }

        $(document).ready(function () {
            $("#menu").kendoPanelBar({
                expandMode: "multiple"
            });

            (function () {
                const label = $("#currentPageLabel");

                function linkText(link) {
                    const clone = link.cloneNode(true);
                    $(clone).find(".k-icon").remove();
                    return $.trim(clone.textContent.replace(/\s+/g, " "));
                }

                const target = window.location.pathname + window.location.search;
                let activeLink = null;

                $("#menu a[href]").each(function () {
                    const href = this.getAttribute("href");
                    if (href && href !== "#" && href === target) {
                        activeLink = this;
                    }
                });

                if (!activeLink) {
                    label.text(document.title.replace(/\s*-\s*Jube\.App\s*$/, ""));
                    return;
                }

                const crumbs = [linkText(activeLink)];
                $(activeLink).closest("li").parentsUntil("#menu", "li").each(function () {
                    const groupLink = $(this).children(".k-link, a").first();
                    if (groupLink.length) {
                        crumbs.unshift(linkText(groupLink[0]));
                    }
                });

                const path = crumbs.join(" › ");
                label.text(path).attr("title", path);
            })();

            const sidebarToggle = $("#sidebarToggle");
            const body = $("body");

            function syncSidebarToggleState() {
                const collapsed = body.hasClass("sidebarCollapsed");
                sidebarToggle.attr("aria-expanded", String(!collapsed));
                sidebarToggle.attr("aria-label", collapsed ? "Expand navigation" : "Collapse navigation");
            }

            syncSidebarToggleState();

            sidebarToggle.on("click", function () {
                const collapsed = body.toggleClass("sidebarCollapsed").hasClass("sidebarCollapsed");
                syncSidebarToggleState();
                try {
                    localStorage.setItem("jubeSidebarCollapsed", collapsed ? "1" : "0");
                } catch (e) {
                    // Private browsing or blocked storage: the preference just won't stick.
                }

                // Kendo widgets, and page-level resize handlers such as the ones Tree.js and
                // AskJooby.js bind to window "resize" (e.g. AskJoobyJs's FixSplitterPaneWidths,
                // which Kendo's own resize cycle does not know to call), only react once the
                // collapse/expand transition has settled; a real resize event covers both,
                // since Kendo widgets already listen for it internally.
                setTimeout(function () {
                    kendo.resize(body, true);
                    window.dispatchEvent(new Event("resize"));
                }, 200);
            });

            const topbarMenuClosers = [];

            function setupTopbarMenu(toggleId, panelId) {
                const toggle = $(toggleId);
                const panel = $(panelId);

                function close() {
                    panel.attr("hidden", true);
                    toggle.attr("aria-expanded", "false");
                }

                toggle.on("click", function (e) {
                    e.stopPropagation();
                    const wasHidden = panel.attr("hidden");
                    topbarMenuClosers.forEach(function (closer) {
                        closer();
                    });
                    if (wasHidden) {
                        panel.removeAttr("hidden");
                        toggle.attr("aria-expanded", "true");
                    }
                });

                topbarMenuClosers.push(close);
            }

            setupTopbarMenu("#resourcesMenuToggle", "#resourcesMenuPanel");
            setupTopbarMenu("#accountMenuToggle", "#accountMenuPanel");

            $(document).on("click", function (e) {
                if (!$(e.target).closest(".topbarMenu").length) {
                    topbarMenuClosers.forEach(function (closer) {
                        closer();
                    });
                }
            });

            $(document).on("keydown", function (e) {
                if (e.key === "Escape") {
                    topbarMenuClosers.forEach(function (closer) {
                        closer();
                    });
                }
            });
        });

        // Ends the session through POST /api/Authentication/Logout (same origin, cookies included), then shows the
        // logout page. Logout fails closed on the server, so whatever the response the page is the right place to land
        // (it offers the button again while the session is still valid).
        async function jubeLogout() {
            try {
                await fetch('/api/Authentication/Logout', {method: 'POST', credentials: 'same-origin'});
            } catch (e) {
                // Network failure: the logout page offers the confirmation button to try again.
            }

            window.location.href = '/Account/Logout';
        }

        (function () {
            const RedirectLogoutCleanly = '/Account/Logout';
            const renderedExpiry = '@(SessionExpiry.Resolve(Context)?.ToString("O") ?? string.Empty)';

            let expiresAt = renderedExpiry ? new Date(renderedExpiry).getTime() : null;

            window.JubeSessionExpiry = {
                set: function (iso) {
                    const parsed = new Date(iso).getTime();
                    if (!isNaN(parsed)) {
                        expiresAt = parsed;
                    }
                },
                get: function () {
                    return expiresAt;
                }
            };

            function updateCountdown(msRemaining) {
                const countdown = document.getElementById('session-countdown');
                if (!countdown) return;
                if (msRemaining <= 0) {
                    countdown.textContent = '00:00';
                    return;
                }
                const totalSeconds = Math.floor(msRemaining / 1000);
                const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
                const seconds = (totalSeconds % 60).toString().padStart(2, '0');
                countdown.textContent = minutes + ':' + seconds;
            }

            $(document).ajaxComplete(function (event, xhr) {
                const refreshed = xhr.getResponseHeader('@SessionExpiry.HeaderName');
                if (refreshed) {
                    window.JubeSessionExpiry.set(refreshed);
                }
            });

            function tick() {
                if (expiresAt === null) {
                    return;
                }

                const msRemaining = expiresAt - Date.now();
                updateCountdown(msRemaining);

                if (msRemaining <= 1000) {
                    window.location.href = RedirectLogoutCleanly;
                }
            }

            tick();
            setInterval(tick, 1_000);
        })();
    </script>
}
@if (showAskJoobyWidget)
{
    @await Html.PartialAsync("Shared/_AskJoobyWidget")
}
</body>
