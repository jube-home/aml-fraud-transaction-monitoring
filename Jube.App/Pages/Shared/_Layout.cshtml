@if (User.Identity is { IsAuthenticated: true })
{
    <script>
        @if (landlord)
        {
            <text>
                function onDataBound() {
                    $.get("/api/UserInTenant/GetCurrentTenantRegistry", function (data) {
                        $("#Tenant").data("kendoDropDownList").value(data.tenantRegistryId);
                    });
                }

                function onSelect(e) {
                    const dataItem = this.dataItem(e.item.index());
                    $.ajax({
                        url: '/api/UserInTenant',
                        type: 'PUT',
                        data: {
                            tenantRegistryId: dataItem.id
                        },
                        success: function () {
                            window.location.reload();
                        }
                    });
                }

                $(document).ready(function () {
                    $("#Tenant").kendoDropDownList({
                        dataTextField: 'name',
                        dataValueField: 'id',
                        filter: 'contains',
                        select: onSelect,
                        dataBound: onDataBound,
                        dataSource: {
                            serverFiltering: true,
                            transport: {
                                read: '/api/TenantRegistry/ByFilter'
                            }
                        }
                    });
                });
            </text>
        }

        $(document).ready(function () {
            $("#menu").kendoMenu();
        });

        // Ends the session through POST /api/Authentication/Logout (same origin, cookies included), then shows the
        // logout page. Logout fails closed on the server, so whatever the response the page is the right place to land
        // (it offers the button again while the session is still valid).
        async function jubeLogout() {
            try {
                await fetch('/api/Authentication/Logout', {method: 'POST', credentials: 'same-origin'});
            } catch (e) {
                // Network failure: the logout page offers the confirmation button to try again.
            }

            window.location.href = '/Account/Logout';
        }

        (function () {
            const pollInterval = 10_000;
            const RedirectLogoutCleanly = '/Account/Logout';

            function getCookie(name) {
                const match = document.cookie.match(
                    new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)')
                );
                return match ? decodeURIComponent(match[1]) : null;
            }

            function updateCountdown(msRemaining) {
                const countdown = document.getElementById('session-countdown');
                if (!countdown) return;
                if (msRemaining <= 0) {
                    countdown.textContent = '00:00';
                    return;
                }
                const totalSeconds = Math.floor(msRemaining / 1000);
                const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
                const seconds = (totalSeconds % 60).toString().padStart(2, '0');
                countdown.textContent = minutes + ':' + seconds;
            }

            let expiresAt = null;

            function checkExpiry() {
                const raw = getCookie('authentication-expiry');

                if (!raw) {
                    window.location.href = RedirectLogoutCleanly;
                    return;
                }

                expiresAt = new Date(raw).getTime();
                const msRemaining = expiresAt - Date.now();

                updateCountdown(msRemaining);

                if (msRemaining <= 1000) {
                    window.location.href = RedirectLogoutCleanly;
                }
            }

            setInterval(checkExpiry, pollInterval);
            checkExpiry();

            setInterval(function () {
                if (expiresAt !== null) {
                    updateCountdown(expiresAt - Date.now());
                }
            }, 1_000);
        })();
    </script>
}
