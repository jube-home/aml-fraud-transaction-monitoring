@page
@model Jube.App.Pages.AskJooby
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "AskJooby";
    ViewData["HideAskJoobyWidget"] = true;
}

@section Scripts
{
    <script>window.AskJoobyIsLandlord = @(Model.IsLandlord ? "true" : "false");</script>
    <script src="/js/AskJooby/AskJoobyStreamClient.js"></script>
    <script src="/js/AskJooby/AskJoobyMarkdown.js" asp-append-version="true"></script>
    <script src="/js/AskJooby/AskJoobyToolIcons.js" asp-append-version="true"></script>
    <script src="/js/AntiforgeryUpload.js"></script>
    <script src="/js/AskJooby/AskJooby.js" asp-append-version="true"></script>
}

<script id="askJoobyConversationTemplate" type="text/x-kendo-template">
    <div class="askJoobyConversationItem" data-id="#: id #">
        <span class="askJoobyConversationTitleGroup">
            <span class="askJoobyConversationTitle">#: title || "Untitled conversation" #</span>
            <span class="askJoobyConversationTime">#= AskJoobyRelativeTime(updatedDate || createdDate) #</span>
        </span>
        <span class="askJoobyConversationDelete" data-id="#: id #" title="Delete">&times;</span>
    </div>
</script>
<div id="askJoobyPage">
    <div id="askJoobySplitter">
        <div id="askJoobyConversationsPane">
            <button type="button" id="askJoobyNew">New Conversation</button>
            <input id="askJoobyConversationSearch" class="k-textbox" placeholder="Search conversations..."
                   aria-label="Search conversations"/>
            <div id="askJoobyConversations"></div>
        </div>
        <div id="askJoobyChatPane">
            <div id="askJoobyTranscript"></div>
            <div id="askJoobyAttachRow">
                <button type="button" id="askJoobyAttachButton">📎 Attach files</button>
                <div id="askJoobyPendingChips"></div>
                <input type="file" id="askJoobyUpload" aria-label="Attach a file" multiple hidden/>
            </div>
            <div id="askJoobyComposer">
                <textarea id="askJoobyInput" placeholder="Ask Jooby..." rows="1"></textarea>
                <button type="button" id="askJoobyStop" title="Cancel the running reply" hidden>Stop</button>
                <button type="button" id="askJoobySend">Send</button>
            </div>
        </div>
    </div>
</div>
