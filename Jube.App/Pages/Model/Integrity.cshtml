@page
@model Jube.App.Pages.Model.Integrity
@{
    Layout = "Shared/_Layout";
}

@section Scripts
{
    <link rel="stylesheet" href="/styles/RuleTools.css"/>
    <script src="/js/Model/Integrity.js"></script>
}

<div class="topPaddedGeneral bottomPaddedGeneral" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
    <label for="IntegrityModel">Model</label>
    <input id="IntegrityModel" style="width:28em"/>
    <button type="button" id="IntegrityRefresh" class="ButtonDefault">Check</button>
    <span id="IntegritySummary"></span>
</div>
<div id="IntegrityTabs">
    <ul>
        <li>Findings</li>
        <li>Engine</li>
        <li>Dependencies</li>
    </ul>
    <div>
        <div id="FindingsGrid"></div>
    </div>
    <div>
        <div id="EngineGrid"></div>
    </div>
    <div>
        <div id="DependenciesNote" class="ruleToolsHint"></div>
        <div id="DependenciesDiagram" style="height:640px;"></div>
        <div id="DependenciesGrid"></div>
    </div>
</div>
