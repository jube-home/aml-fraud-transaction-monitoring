@page
@model Jube.App.Pages.Model.AskJoobyAnalytics
@{
    Layout = "Shared/_Layout";
}

@section Scripts
{
    <link rel="stylesheet" href="/styles/advanced-analytics.css"/>
    <script src="/js/EvidenceTree.js"></script>
    <script src="/js/Model/AskJoobyAnalytics.js"></script>
}

<input type="hidden" id="CanDelete" value="@(Model.CanDelete ? "true" : "false")"/>
<input type="hidden" id="CanDeleteAllocated" value="@(Model.CanDeleteAllocated ? "true" : "false")"/>
<input type="hidden" id="CanSetActive" value="@(Model.CanSetActive ? "true" : "false")"/>
<div id="ErrorMessage" class="errorMessage"></div>
<div class="fCStyle">
    <div id="InstanceGrid"></div>
    <div class="footerStyle">
        <button type="button" id="RefreshInstances" class="ButtonDefault">Refresh</button>
        <button type="button" id="ApproveAllPendingInstances" class="ButtonDefault">Approve all pending</button>
    </div>
</div>
<div id="EvidenceEmpty" class="aa-empty">Expand an instance, expand a model, and choose Evidence on a version.</div>
<div id="EvidencePanel" class="aa-hidden">
    <div class="aa-banner">
        This page is view only. Promotion, rollback, allocation, training and every other change to Advanced
        Analytics are made through the agent, which decides on this evidence. A version with junk statistics
        should not be promoted: no significant coefficients, a very small held-out set, perfect separation,
        non convergence or a held-out AUC close to 0.5.
    </div>
    <div class="aa-summary">
        <span id="EvidenceTitle" class="aa-title"></span>
        <span id="EvidenceLive" class="aa-badge aa-hidden">Live</span>
        <span id="EvidenceAllocation" class="aa-hint"></span>
    </div>
    <div id="NarrativeHolistic" class="narrative"></div>
    <div class="aa-subtitle">Evidence</div>
    <div id="EvidenceTree"></div>
    <div class="aa-charts" id="EvidenceCharts">
        <div class="aa-chart-card" id="DiagramCard">
            <div id="NarrativeModelDiagram" class="narrative"></div>
            <div id="DiagramChart" class="aa-chart"></div>
        </div>
        <div class="aa-chart-card aa-hidden" id="CalibrationCard">
            <div id="NarrativeCalibration" class="narrative"></div>
            <div id="CalibrationChart" class="aa-chart"></div>
        </div>
        <div class="aa-chart-card aa-hidden" id="RocCard">
            <div id="NarrativeRoc" class="narrative"></div>
            <div id="RocChart" class="aa-chart"></div>
        </div>
    </div>
</div>
