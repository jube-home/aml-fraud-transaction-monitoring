@page
@model Jube.App.Pages.Administration.PreservationSnapshot
@{
    Layout = "Shared/_Layout";
}

@section Scripts
{
    <script>
        const canImportSnapshot = @Json.Serialize(Model.CanImport);
    </script>
    <script src="/js/Administration/PreservationSnapshot.js"></script>
}

<div class="topPaddedGeneral bottomPaddedGeneral">
    <button id="Take" type="button">Take Snapshot</button>
    <input class="k-textbox" id="Name" type="text" placeholder="Optional label">
    <span id="Updating" hidden="hidden" class="updating">Working</span>
    <span class="hint">A snapshot records this tenant's configuration so it can be restored later.</span>
</div>
<div id="ErrorMessage" class="errorMessage"></div>
<div id="grid"></div>
